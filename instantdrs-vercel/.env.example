# InstantDRS Vercel Backend — Environment Variables
# ==================================================
# Copy this file to .env.local for local development (vercel dev).
# Set these in Vercel Dashboard → Project → Settings → Environment Variables for production.
#
# NEVER commit real values to git. The .gitignore already excludes .env.local.

# ============================================================
# DATABASE — PlanetScale (MySQL-compatible, serverless HTTP)
# ============================================================
# Format: mysql://<user>:<password>@<host>/<database>
# Get from: PlanetScale Dashboard → Connect → Connect with @planetscale/database
DATABASE_URL=mysql://username:password@aws.connect.psdb.cloud/instant_drs?ssl={"rejectUnauthorized":true}

# ============================================================
# VIDEO STORAGE — Cloudinary
# ============================================================
# Get from: Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# SECURITY — JWT Authentication & Private Session Authorization
# ============================================================
# Generate a strong random secret (min 32 chars): openssl rand -base64 32
JWT_SECRET=your-secure-32-byte-base64-or-random-secret-key-here
